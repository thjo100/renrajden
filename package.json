{
  "name": "renrajden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Webbplats för Renrajden – OK Renens seedningslopp inför Vasaloppet",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "build": "vite build",
    "build:emulator": "vite build --mode emulator",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-renrajden",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "test:unit": "node --test tests/cms.test.mjs tests/media.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-renrajden \"node --test --test-concurrency=1 tests/rules.test.mjs tests/storage.test.mjs\"",
    "test:e2e": "npm run build:emulator && firebase emulators:exec --only auth,firestore,storage --project demo-renrajden \"node tests/e2e.mjs\"",
    "admin": "node scripts/admin.mjs",
    "seed": "node scripts/seed-news.mjs",
    "segrare": "node scripts/segrare.mjs",
    "proto:preview": "node dev/build-preview.cjs",
    "proto:preview:admin": "node dev/build-preview.cjs --admin",
    "proto:shots": "node dev/shots.cjs",
    "proto:verify": "node dev/verify.cjs"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/familjen-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "firebase": "13.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.35.0",
    "playwright": "1.63.0",
    "vite": "8.3.7"
  },
  "engines": {
    "node": ">=20"
  }
}
