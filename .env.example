# Kopiera till .env.local och fyll i från Firebase-konsolen:
# Projektinställningar → Allmänt → Dina appar → webbapp → SDK-konfiguration.
# Webbkonfigurationen är inte hemlig (den syns i webbläsaren), men håll den utanför repot
# om du vill. I GitHub Actions läggs värdena som repository variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Frivillig: värdet storageBucket. Behövs för att admins ska kunna ladda upp bilder och filmer.
VITE_FIREBASE_STORAGE_BUCKET=
