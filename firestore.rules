rules_version = '2';

// Renrajden – säkerhetsregler
//
// * Nyheter (news), årets lopp (settings/event), partnerna (settings/partners),
//   resultatarkivet (years) och bilderna (media, settings/media) kan läsas av alla, även utan inloggning.
// * Bara administratörer får skapa, ändra och ta bort dem.
// * Administratör = inloggad med Google, verifierad e-post, och dokumentet
//   admins/{e-post i gemener} finns. Adminlistan hanteras med `npm run admin`
//   (firebase-admin) eller i Firebase-konsolen – aldrig från webbläsaren.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return signedInWithGoogle()
        && exists(/databases/$(database)/documents/admins/$(emailKey()));
    }

    function validLink(l) {
      return l is map
        && l.keys().hasOnly(['label', 'url'])
        && l.label is string && l.label.size() <= 80
        && l.url is string && l.url.size() <= 2000
        && l.url.matches('^https://[^ <>"]+$');
    }

    // Regler kan inte loopa, så varje position kontrolleras för sig (max 12 länkar).
    function validLinks(ls) {
      return ls is list && ls.size() <= 12
        && (ls.size() < 1 || validLink(ls[0]))
        && (ls.size() < 2 || validLink(ls[1]))
        && (ls.size() < 3 || validLink(ls[2]))
        && (ls.size() < 4 || validLink(ls[3]))
        && (ls.size() < 5 || validLink(ls[4]))
        && (ls.size() < 6 || validLink(ls[5]))
        && (ls.size() < 7 || validLink(ls[6]))
        && (ls.size() < 8 || validLink(ls[7]))
        && (ls.size() < 9 || validLink(ls[8]))
        && (ls.size() < 10 || validLink(ls[9]))
        && (ls.size() < 11 || validLink(ls[10]))
        && (ls.size() < 12 || validLink(ls[11]));
    }

    function validNews(d) {
      return d.keys().hasOnly(['title', 'date', 'tag', 'body', 'links', 'pinned', 'alert',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['title', 'date', 'tag', 'body', 'links', 'pinned', 'alert',
                            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.tag in ['Info', 'Resultat', 'Ändring', 'Inställt', 'Valla']
        && d.body is string && d.body.size() <= 4000
        && validLinks(d.links)
        && d.pinned is bool
        && d.alert is bool
        && d.createdAt is timestamp
        && (d.createdBy == null || d.createdBy is string)
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    match /news/{newsId} {
      allow read: if true;
      allow create: if isAdmin() && validNews(request.resource.data);
      allow update: if isAdmin() && validNews(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // ---------- Årets lopp (settings/event) och resultatarkivet (years/{år}) ----------
    // Alla kan läsa, bara admins kan skriva. Gränserna ska stämma med LIMITS i src/cms/model.js.

    function isoDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function optionalHttps(u) {
      return u is string && u.size() <= 2000 && (u == '' || u.matches('^https://[^ <>"]+$'));
    }

    // Arkivet har gamla länkar som bara finns på http, så här godtas både http och https.
    function validWebLink(l) {
      return l is map
        && l.keys().hasOnly(['label', 'url']) && l.keys().hasAll(['label', 'url'])
        && l.label is string && l.label.size() <= 80
        && l.url is string && l.url.size() <= 2000
        && l.url.matches('^https?://[^ <>"]+$');
    }

    function validWebLinks(ls) {
      return ls is list && ls.size() <= 12
        && (ls.size() < 1 || validWebLink(ls[0]))
        && (ls.size() < 2 || validWebLink(ls[1]))
        && (ls.size() < 3 || validWebLink(ls[2]))
        && (ls.size() < 4 || validWebLink(ls[3]))
        && (ls.size() < 5 || validWebLink(ls[4]))
        && (ls.size() < 6 || validWebLink(ls[5]))
        && (ls.size() < 7 || validWebLink(ls[6]))
        && (ls.size() < 8 || validWebLink(ls[7]))
        && (ls.size() < 9 || validWebLink(ls[8]))
        && (ls.size() < 10 || validWebLink(ls[9]))
        && (ls.size() < 11 || validWebLink(ls[10]))
        && (ls.size() < 12 || validWebLink(ls[11]));
    }

    function validDistance(d) {
      return d is map
        && d.keys().hasOnly(['km', 'laps', 'classes', 'fee', 'lateFee', 'note'])
        && d.keys().hasAll(['km', 'laps', 'classes', 'fee', 'lateFee', 'note'])
        && d.km is number && d.km > 0 && d.km <= 100
        && d.laps is int && d.laps >= 1 && d.laps <= 6
        && d.classes is string && d.classes.size() > 0 && d.classes.size() <= 40
        && d.fee is int && d.fee >= 0 && d.fee <= 10000
        && d.lateFee is int && d.lateFee >= 0 && d.lateFee <= 10000
        && d.note is string && d.note.size() <= 200;
    }

    function validDistances(ls) {
      return ls is list && ls.size() >= 1 && ls.size() <= 4
        && validDistance(ls[0])
        && (ls.size() < 2 || validDistance(ls[1]))
        && (ls.size() < 3 || validDistance(ls[2]))
        && (ls.size() < 4 || validDistance(ls[3]));
    }

    function validEvent(d) {
      return d.keys().hasOnly(['date', 'startTime', 'status', 'venue', 'venueArea', 'mapUrl', 'deadline',
                               'registrationUrl', 'startListUrl', 'liveResultsUrl', 'email',
                               'lapKm', 'climbPerLap', 'waterPerLap', 'coldLimit', 'distances',
                               'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['date', 'startTime', 'status', 'venue', 'venueArea', 'mapUrl', 'deadline',
                            'registrationUrl', 'startListUrl', 'liveResultsUrl', 'email',
                            'lapKm', 'climbPerLap', 'waterPerLap', 'coldLimit', 'distances',
                            'updatedAt', 'updatedBy'])
        && isoDate(d.date)
        && d.startTime is string && d.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.status in ['planned', 'cancelled']
        && d.venue is string && d.venue.size() > 0 && d.venue.size() <= 60
        && d.venueArea is string && d.venueArea.size() <= 60
        && optionalHttps(d.mapUrl)
        && d.deadline is string && (d.deadline == '' || isoDate(d.deadline))
        && optionalHttps(d.registrationUrl)
        && optionalHttps(d.startListUrl)
        && optionalHttps(d.liveResultsUrl)
        && d.email is string && d.email.size() <= 100 && d.email.matches('^[^@ <>"]+@[^@ <>"]+[.][^@ <>"]+$')
        && d.lapKm is number && d.lapKm > 0 && d.lapKm <= 50
        && d.climbPerLap is int && d.climbPerLap >= 0 && d.climbPerLap <= 2000
        && d.waterPerLap is int && d.waterPerLap >= 0 && d.waterPerLap <= 10
        && d.coldLimit is int && d.coldLimit >= -50 && d.coldLimit <= 0
        && validDistances(d.distances)
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    function validWinner(w) {
      return w is map
        && w.keys().hasOnly(['class', 'names']) && w.keys().hasAll(['class', 'names'])
        && w['class'] is string && w['class'].size() <= 40
        && w.names is string && w.names.size() > 0 && w.names.size() <= 200;
    }

    function validWinners(ls) {
      return ls is list && ls.size() <= 6
        && (ls.size() < 1 || validWinner(ls[0]))
        && (ls.size() < 2 || validWinner(ls[1]))
        && (ls.size() < 3 || validWinner(ls[2]))
        && (ls.size() < 4 || validWinner(ls[3]))
        && (ls.size() < 5 || validWinner(ls[4]))
        && (ls.size() < 6 || validWinner(ls[5]));
    }

    function validYear(d, id) {
      return d.keys().hasOnly(['year', 'status', 'date', 'text', 'winners', 'links', 'invitation', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['year', 'status', 'date', 'text', 'winners', 'links', 'invitation', 'updatedAt', 'updatedBy'])
        && id.matches('^[0-9]{4}$')
        && d.year is int && d.year == int(id) && d.year >= 1990 && d.year <= 2100
        && d.status in ['held', 'cancelled']
        && d.date is string && (d.date == '' || isoDate(d.date))
        && d.text is string && d.text.size() <= 300
        && validWinners(d.winners)
        && validWebLinks(d.links)
        && (d.invitation == null || validWebLink(d.invitation))
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    // ---------- Partners (settings/partners) ----------
    // Gränserna ska stämma med LIMITS i src/cms/model.js (short = 60, partners = 12, former = 500).

    // Varje uttryck räknas mot reglernas gräns på 1000 uttryck per skrivning, så kontrollen är
    // så kort som möjligt: matches() fungerar bara på text och nekar därför allt annat.
    // En partner kostar ungefär 60 uttryck. Med fler än 16 partners nås gränsen, därför max 12.
    function validPartner(p) {
      return p.keys().size() == 3 && p.keys().hasAll(['name', 'text', 'url'])
        && p.name.matches('^.{1,60}$')
        && p.text.matches('^.{0,60}$')
        && p.url.matches('^(https://[^ <>"]+)?$') && p.url.size() <= 2000;
    }

    function validPartnerList(ls) {
      return ls is list && ls.size() <= 12
        && (ls.size() < 1 || validPartner(ls[0]))
        && (ls.size() < 2 || validPartner(ls[1]))
        && (ls.size() < 3 || validPartner(ls[2]))
        && (ls.size() < 4 || validPartner(ls[3]))
        && (ls.size() < 5 || validPartner(ls[4]))
        && (ls.size() < 6 || validPartner(ls[5]))
        && (ls.size() < 7 || validPartner(ls[6]))
        && (ls.size() < 8 || validPartner(ls[7]))
        && (ls.size() < 9 || validPartner(ls[8]))
        && (ls.size() < 10 || validPartner(ls[9]))
        && (ls.size() < 11 || validPartner(ls[10]))
        && (ls.size() < 12 || validPartner(ls[11]));
    }

    function validPartners(d) {
      return d.keys().hasOnly(['partners', 'former', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['partners', 'former', 'updatedAt', 'updatedBy'])
        && validPartnerList(d.partners)
        && d.former is string && d.former.size() <= 500
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    // ---------- Bilder och filmer (media/{id} och settings/media) ----------
    // Gränserna ska stämma med src/media.js. Filerna ligger antingen i sajten (/bilder/…, bilderna från
    // gamla bloggen) eller i Cloud Storage under galleri/{id}/, där id är dokumentets id (se storage.rules).

    function validMediaFile(p, id, video) {
      return p is string && p.size() <= 300
        && (p.matches('^/(bilder|video)/[A-Za-z0-9/._-]+$')
          || (video && p.matches('^galleri/' + id + '/film[.](mp4|webm|mov)$'))
          || (!video && p.matches('^galleri/' + id + '/bild[.](jpg|png|gif)$')));
    }

    function validMediaThumb(p, id) {
      return p is string && p.size() <= 300
        && (p.matches('^/(bilder|video)/[A-Za-z0-9/._-]+$') || p == 'galleri/' + id + '/mini.jpg');
    }

    function validMedia(d, id) {
      return d.keys().hasOnly(['type', 'category', 'year', 'text', 'file', 'thumb', 'width', 'height', 'duration',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['type', 'category', 'year', 'text', 'file', 'thumb', 'width', 'height', 'duration',
                            'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && id.matches('^[A-Za-z0-9-]{1,80}$')
        && ((d.type == 'image' && d.category in ['foton', 'affischer', 'banor', 'sponsorer', 'seedning'] && d.duration == null)
          || (d.type == 'video' && d.category == 'filmer' && d.duration is number && d.duration >= 0 && d.duration <= 36000))
        && (d.year == null || (d.year is int && d.year >= 1990 && d.year <= 2100))
        && d.text is string && d.text.size() <= 200
        && validMediaFile(d.file, id, d.type == 'video')
        && validMediaThumb(d.thumb, id)
        && d.width is int && d.width >= 1 && d.width <= 20000
        && d.height is int && d.height >= 1 && d.height <= 20000
        && d.createdAt is timestamp
        && (d.createdBy == null || d.createdBy is string)
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    match /media/{mediaId} {
      allow read: if true;
      allow create: if isAdmin() && validMedia(request.resource.data, mediaId);
      allow update: if isAdmin() && validMedia(request.resource.data, mediaId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // settings/media visar att bilderna har flyttats till samlingen media. Finns det inte visar
    // sajten bilderna i public/bilder/bilder.json.
    function validMediaSettings(d) {
      return d.keys().hasOnly(['initialized', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['initialized', 'updatedAt', 'updatedBy'])
        && d.initialized == true
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    // Bara dokumenten "event", "partners" och "media" finns. De kan inte tas bort, bara ändras.
    match /settings/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && ((docId == 'event' && validEvent(request.resource.data))
          || (docId == 'partners' && validPartners(request.resource.data))
          || (docId == 'media' && validMediaSettings(request.resource.data)));
      allow delete: if false;
    }

    // Dokument-ID är årtalet, t.ex. years/2025.
    match /years/{yearId} {
      allow read: if true;
      allow create, update: if isAdmin() && validYear(request.resource.data, yearId);
      allow delete: if isAdmin();
    }

    match /admins/{email} {
      // Den inloggade får bara läsa sitt eget dokument (för att veta om hen är admin).
      allow get: if signedInWithGoogle() && email == emailKey();
      allow list, create, update, delete: if false;
    }

    // Allt annat är stängt.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
